# application.properties - TEMPLATE (Sao chép thành application-local.properties và điền giá trị thực)

spring.application.name=backend

# Database (Thay đổi theo môi trường của bạn)
spring.datasource.url=jdbc:mysql://localhost:3306/fish_pond_management?serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.open-in-view=false

# Thresholds
monitoring.thresholds.ph-watch-min=6.5
monitoring.thresholds.ph-watch-max=8.5
monitoring.thresholds.ph-high-min=6.0
monitoring.thresholds.ph-high-max=9.0
monitoring.thresholds.ph-critical-min=5.0
monitoring.thresholds.ph-critical-max=10.0
monitoring.thresholds.do-watch-min=5.0
monitoring.thresholds.do-high-min=4.0
monitoring.thresholds.do-critical-min=2.0
monitoring.thresholds.turbidity-watch-max=5
monitoring.thresholds.turbidity-high-max=25
monitoring.thresholds.turbidity-critical-max=50
monitoring.thresholds.tds-watch-max=500
monitoring.thresholds.tds-high-max=1000
monitoring.thresholds.tds-critical-max=2000

monitoring.minimum-daily-samples=24
monitoring.device-offline-timeout=300s

# ThingSpeak Cloud Synchronization
thingspeak.enabled=true
thingspeak.channel-id=YOUR_CHANNEL_ID
thingspeak.read-api-key=YOUR_READ_API_KEY
thingspeak.poll-interval-ms=15000
